# VULCAN frontend environment — client-safe EXPO_PUBLIC_* values only.
# The Supabase anon key is safe to ship; NEVER put secrets here (service-role key,
# Gemini key, etc. live server-side in backend/.env).
# Copy to .env and fill in. This file (.env.example) is what gets committed.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000

# Set to false to hide AI quota meters/gates (must mirror backend QUOTA_ENABLED).
EXPO_PUBLIC_AI_QUOTA_ENABLED=true