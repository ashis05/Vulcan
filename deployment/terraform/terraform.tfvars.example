# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

# Named AWS CLI profile holding the target account's credentials.
aws_profile      = "vulcan-prod"
region           = "ap-south-1"
project          = "vulcan"
instance_type    = "t4g.micro"
ami_architecture = "arm64"
root_volume_gb   = 16
swap_size_gb     = 2

# Contents of ~/.ssh/vulcan_deploy.pub (the public half of the deploy key).
ssh_public_key = "ssh-ed25519 AAAA...REPLACE_ME... vulcan-deploy"

# 0.0.0.0/0 lets GitHub Actions runners deploy. Key-only auth still applies.
# Tighten to e.g. ["203.0.113.4/32"] plus GitHub's ranges when you no longer
# need dynamic runners to reach the box.
ssh_allowed_cidrs = ["0.0.0.0/0"]
