# VULCAN backend environment — NEVER commit the real .env.
# Copy this file to .env and fill in.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# In production set this to the public API origin (e.g. https://api-vulcan.ashiswadhwani.in).
ALLOWED_ORIGINS=*

# Postgres connection string for Alembic migrations (Supabase → Connect → Session pooler URI).
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# AI layer (Phase 4+) — server-side secrets, never commit the real .env.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Which Gemini model to use. Valid options include:
#   gemini-3.1-flash-lite (default), gemini-3.5-flash-lite, gemini-flash-lite-latest, gemini-3.8-flash
# An invalid name falls back to gemini-3.1-flash-lite automatically.
# GEMINI_MODEL=gemini-3.1-flash-lite

# Per-feature free-tier quotas.
# Set QUOTA_ENABLED=false to disable all AI quota enforcement (dev/testing).
# Counters still record for analytics; no 429s are returned.
QUOTA_ENABLED=true
QUOTA_FOOD_PER_DAY=5
QUOTA_PROGRAM_PER_DAYS=7
QUOTA_PHYSIQUE_PER_DAYS=7

# Production only (see deployment/02-cloudflare-tunnel.md). The Cloudflare Tunnel
# runs as the cf-tunnel compose service from a locally-managed config: on the
# instance, ~/vulcan/cloudflared holds config.yml + <tunnel-id>.json (mounted
# read-only into the container). There is no tunnel token in this file.