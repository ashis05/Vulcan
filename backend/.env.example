# VULCAN backend environment — NEVER commit the real .env.
# Copy this file to .env and fill in.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
ALLOWED_ORIGINS=*

# Postgres connection string for Alembic migrations (Supabase → Connect → Session pooler URI).
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# AI layer (Phase 4+) — server-side secrets, never commit the real .env.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# Per-feature free-tier quotas.
QUOTA_FOOD_PER_DAY=5
QUOTA_PROGRAM_PER_DAYS=7
QUOTA_PHYSIQUE_PER_DAYS=7